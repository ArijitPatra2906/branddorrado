# Public values only. Never put secrets in VITE_ variables.
VITE_API_BASE_URL=http://localhost:4000/api
# Set to false to always use the static hero (disables the WebGL scroll story)
VITE_ENABLE_3D=true
VITE_ENABLE_3D_MOBILE=true

# Build-time only (used by `npm run build` to prerender public pages for SEO)
# SITE_URL=https://www.yourdomain.com
# PRERENDER_API_URL=https://api.yourdomain.com/api
# PRERENDER_STRICT=true
