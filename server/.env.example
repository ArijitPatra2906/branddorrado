NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173
CLIENT_URLS=http://localhost:5173
PUBLIC_SITE_URL=http://localhost:5173
# Local dev: file:./local.db. Production: libsql://<db>-<org>.turso.io
TURSO_DATABASE_URL=file:./local.db
TURSO_AUTH_TOKEN=
# Resend email credentials
RESEND_API_KEY=
BRAND_EMAIL_FROM=BrandDorrado <onboarding@resend.dev>
BRAND_LEAD_EMAIL_TO=hello@yourdomain.com
# 32+ character random secret
SESSION_SECRET=change-this-to-a-secure-random-string-at-least-32-chars
COOKIE_DOMAIN=
# Developer secret required for initial super admin setup
ADMIN_SETUP_SECRET=change-this-to-a-secure-secret
PUBLIC_API_URL=http://localhost:4000
LOG_REQUESTS=true
API_RATE_LIMIT=600
